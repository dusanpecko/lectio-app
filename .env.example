# Flutter Mobile Environment Variables Template
# Skopíruj tento súbor ako .env a vyplň správne hodnoty

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Configuration
APP_NAME=Lectio Divina
APP_VERSION=1.0.0

# Development/Production flags
ENVIRONMENT=development

# Firebase Configuration (integrácia cez Firebase Console)
# Tieto hodnoty sú zvyčajne v firebase_options.dart